APP_NAME=Serbizyu
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=serbizyu
DB_USERNAME=serbizyu
DB_PASSWORD=
DB_READ_HOSTS=db
DB_WRITE_HOSTS=db
DB_STICKY=true

SESSION_DRIVER=redis
SESSION_STORE=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="local@serbizyu.test"
MAIL_FROM_NAME="${APP_NAME}"

SERBIZYU_ENV=local
SERBIZYU_VALIDATE_ENV=true
SERBIZYU_EVIDENCE_CLASS=TEAM_TRAINING
SERBIZYU_PAYMENT_PROVIDER_MODE=disabled
SERBIZYU_PAYMENT_PROVIDER_CREDENTIALS=
SERBIZYU_NOTIFICATION_PROVIDER_MODE=disabled
SERBIZYU_NOTIFICATION_PROVIDER_CREDENTIALS=
SERBIZYU_EVIDENCE_PROVIDER_MODE=local
SERBIZYU_EVIDENCE_PROVIDER_CREDENTIALS=
SERBIZYU_HEALTH_DATABASE_REQUIRED=false
SERBIZYU_HEALTH_REDIS_REQUIRED=false

VITE_APP_NAME="${APP_NAME}"
